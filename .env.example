# GreenRoute Firebase Web App Configuration Template
# Copy this file to .env.local and replace with your project credentials from Firebase Console.
# (Firebase Console > Project Settings > General > Your apps > Web app)
# IMPORTANT: Never commit .env.local or real credentials to Git.

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=greenroute-57125.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=greenroute-57125
VITE_FIREBASE_STORAGE_BUCKET=greenroute-57125.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
